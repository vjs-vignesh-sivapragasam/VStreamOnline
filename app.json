{
  "expo": {
    "name": "vplex",
    "slug": "vstreamonline",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "assets/images/icon.png",
    "scheme": "vstreamonline",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080a"
    },
    "ios": {
      "icon": "assets/images/icon.png",
      "supportsTablet": true,
      "backgroundColor": "#000000",
      "bundleIdentifier": "com.vijayyuvi.vstreamonline",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "LSApplicationQueriesSchemes": [
          "vlc",
          "vlc-x-callback",
          "infuse",
          "outplayer",
          "open-vidhub"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.vijayyuvi.vstreamonline",
      "supportsPictureInPicture": true,
      "icon": "assets/images/icon.png",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withKSPlayer",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFB800"
        }
      ],
      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "enableBackgroundAudio": true,
          "enableAndroidPictureInPicture": true
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "27.0.12077973",
            "packagingOptions": {
              "pickFirst": []
            },
            "extraMavenRepos": [],
            "abiFilters": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "79c70d7a-9507-41fd-86a4-c935b292399d"
      }
    },
    "owner": "vijayvcm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/79c70d7a-9507-41fd-86a4-c935b292399d"
    }
  }
}
